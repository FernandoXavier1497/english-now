@model EnglishNow.Web.Models.Boletim.MeuBoletimViewModel
@{
    ViewData["Title"] = "Meu boletim";
}

<h1>Meu boletim</h1>

@if (Model.AlunoNome != null)
{
    <p class="lead">@Model.AlunoNome</p>
}

@if (Model.Boletins.Count == 0)
{
    <p class="text-body-secondary">Você ainda não está matriculado em nenhuma turma.</p>
}

@foreach (var b in Model.Boletins)
{
    <div class="card mb-4">
        <div class="card-header">
            <b>@b.TurmaDescricao</b> <span class="text-body-secondary">&middot; Professor: @b.ProfessorNome</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle text-center mb-0">
                <thead>
                    <tr>
                        <th></th>
                        <th>Escrita</th>
                        <th>Leitura</th>
                        <th>Conversação</th>
                        <th>Média</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th class="text-start">1º bimestre</th>
                        <td>@b.NotaBim1Escrita.Nota()</td>
                        <td>@b.NotaBim1Leitura.Nota()</td>
                        <td>@b.NotaBim1Conversacao.Nota()</td>
                        <td><b>@b.NotaBim1Final.Nota()</b></td>
                    </tr>
                    <tr>
                        <th class="text-start">2º bimestre</th>
                        <td>@b.NotaBim2Escrita.Nota()</td>
                        <td>@b.NotaBim2Leitura.Nota()</td>
                        <td>@b.NotaBim2Conversacao.Nota()</td>
                        <td><b>@b.NotaBim2Final.Nota()</b></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            Final do semestre: <b>@b.NotaFinalSemestre.Nota()</b> &middot; Faltas: <b>@b.FaltasSemestre.Faltas()</b>
        </div>
    </div>
}
