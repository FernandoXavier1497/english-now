@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal EnglishNow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnglishNow.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>

        <nav class="navbar navbar-expand-md navbar-dark fixed-top bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">EnglishNow</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "Home" ? "active" : "")" href="/">Home</a>
                        </li>
                        @if (User.IsInRole(Perfis.Administrador))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Aluno" ? "active" : "")" asp-controller="Aluno" asp-action="Listar">Alunos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Professor" ? "active" : "")" asp-controller="Professor" asp-action="Listar">Professores</a>
                            </li>
                        }
                        @if (User.IsInRole(Perfis.Administrador) || User.IsInRole(Perfis.Professor))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Turma" || controllerAtual == "Boletim" ? "active" : "")" asp-controller="Turma" asp-action="Listar">Turmas</a>
                            </li>
                        }
                        @if (User.IsInRole(Perfis.Aluno))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controllerAtual == "Boletim" ? "active" : "")" asp-controller="Boletim" asp-action="MeuBoletim">Meu boletim</a>
                            </li>
                        }
                    </ul>
                    <form class="d-flex align-items-center" asp-controller="Usuario" asp-action="Logout" method="post">
                        <span class="navbar-text text-white me-3">@User.Identity?.Name</span>
                        <button class="btn btn-outline-light" type="submit">Sair</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top">
            <p class="col-md-4 mb-0 text-body-secondary">&copy; 2025 Centro Educacional EnglishNow</p>

            <a href="/" class="col-md-4 d-flex align-items-center justify-content-center mb-3 mb-md-0 me-md-auto link-body-emphasis text-decoration-none">
                <b> EnglishNow</b>
            </a>

            <div class="col-md-4"></div>
        </footer>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
